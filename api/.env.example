# Backend API server configuration. Copy to .env and fill in.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Nebius Token Factory (NVIDIA Nemotron Reasoning Engine)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# Tavily AI Search Engine (Best Use of Tavily Bonus)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# Gemini Live (Spoken voice agent & embeddings)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase (Service role key is server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used for migrations
DATABASE_URL=

# Secrets: at least 32 chars. AUTH_SECRET signs session tokens. CRON_SECRET guards POST /api/pipeline/batch.
AUTH_SECRET=
CRON_SECRET=

# Secondary events source fallback (https://gnews.io). Optional when Tavily is configured.
GNEWS_API_KEY=

# Live voice limits per user per IST day, and the cap on one session's model tokens and tool calls.
VOICE_SESSIONS_PER_DAY=2
VOICE_TOKENS_PER_SESSION=2000000
VOICE_TOKENS_PER_DAY=4000000
VOICE_MAX_TOOL_CALLS=60
